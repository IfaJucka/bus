# ==========================================
# SMART COLLEGE BUS TRANSPORTATION SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# BACKEND (Node.js / Express Server)
# ------------------------------------------
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-app.vercel.app

# Supabase PostgreSQL Integration (https://supabase.com)
# Obtain these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Local MySQL Database (used only if Supabase credentials are not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_bus_tracking

# JWT & Authentication Security Secrets
JWT_SECRET=your_jwt_super_secure_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@anjuman.edu

# Optional External Routing / SMS Service (Leave blank to use built-in accurate road engine)
ROUTING_API_KEY=
SMS_API_KEY=

# ------------------------------------------
# FRONTEND (Vercel Client Environment Variables)
# Prefix with VITE_ to expose to client bundle
# ------------------------------------------
# Production Backend URL (e.g., deployed on Render, Railway, or VPS)
VITE_API_URL=https://your-backend-api.onrender.com
VITE_SOCKET_URL=https://your-backend-api.onrender.com

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
